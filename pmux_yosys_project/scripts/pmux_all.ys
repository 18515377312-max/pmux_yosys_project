# ========== 1 pmux_case01_balanced ==========
design -reset
read_verilog /mnt/hgfs/yosys_share/pmux_case01_balanced.v
hierarchy -check -top pmux_case01_balanced
synth_ice40
stat
write_verilog /mnt/hgfs/yosys_share/synth_result/out01_balanced.v
write_blif /mnt/hgfs/yosys_share/synth_result/out01_balanced.blif
show -prefix /mnt/hgfs/yosys_share/synth_result/sch01_balanced -format svg

